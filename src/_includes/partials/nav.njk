<header class="nav site-nav">
  {%- set localePrefix = locale.prefix or '' -%}
  {%- set labels = locale.labels or {} -%}
  {%- set aiHref = localePrefix + '/ai/' -%}
  {%- if localePrefix == '/de' -%}
    {%- set aiHref = '/ai/' -%}
  {%- endif -%}
  <a class="nav-back" href="{{ navBackHref or (localePrefix + '/tools/') }}"><span aria-hidden="true">&larr;</span> {{ navBackLabel or labels.allTools or 'all tools' }}</a>
  <a class="nav-logo" href="{{ localePrefix }}/" aria-label="Spinnit home">spinn<span>it</span></a>
  <nav class="nav-links" aria-label="{{ labels.primaryNavigation or 'Primary navigation' }}">
    {%- if localePrefix == '' %}
    <a href="/learn/">Learn AI</a>
    <a href="/ai/">AI tools</a>
    <a href="/classroom-random-tools/">classroom</a>
    <a href="/tools/">all tools</a>
    <a href="/blog/">guides</a>
    {%- else %}
    <a href="{{ localePrefix }}/tools/">{{ labels.tools or 'tools' }}</a>
    <a href="{{ localePrefix }}/blog/">{{ labels.blog or 'blog' }}</a>
    <a href="{{ aiHref }}">AI</a>
    {%- endif %}
  </nav>
</header>
