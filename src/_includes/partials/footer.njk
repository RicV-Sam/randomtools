<footer>
{%- set localePrefix = '' -%}
{%- if lang and languages and lang != languages.default -%}
  {%- set localePrefix = '/' + lang -%}
{%- endif -%}
{%- if footerVariant == "short" %}
  <p>Spinnit &copy; {{ site.year }} - free forever &nbsp;|&nbsp; <a href="{{ localePrefix }}/privacy.html">Privacy</a> &nbsp;|&nbsp; <a href="{{ localePrefix }}/about.html">About</a></p>
{%- else %}
  <p>Spinnit &copy; {{ site.year }} - free forever &nbsp;|&nbsp; <a href="{{ localePrefix }}/tools/">All Tools</a> &nbsp;|&nbsp; <a href="/ai/">AI Tools</a> &nbsp;|&nbsp; <a href="{{ localePrefix }}/blog/">Blog</a> &nbsp;|&nbsp; <a href="{{ localePrefix }}/privacy.html">Privacy</a> &nbsp;|&nbsp; <a href="{{ localePrefix }}/terms.html">Terms</a> &nbsp;|&nbsp; <a href="{{ localePrefix }}/about.html">About</a> &nbsp;|&nbsp; <a href="{{ localePrefix }}/contact.html">Contact</a></p>
{%- endif %}
</footer>