<!DOCTYPE html>
<html lang="{{ locale.code or lang or 'en' }}" dir="{{ locale.dir or dir or 'ltr' }}">
<head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-1F50QF6G4B"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-1F50QF6G4B');
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsenseClient }}" crossorigin="anonymous"></script>
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{%- set canonicalPath = canonical | replace(site.url, "") if canonical else page.url %}
{%- set localeIncomplete = translationStatus == "incomplete" or (incompleteLocalePages and incompleteLocalePages.indexOf(canonicalPath) != -1) or (incompleteLocalePages and incompleteLocalePages.indexOf(page.url) != -1) %}
{%- set isNoindex = noindex or localeIncomplete %}
{%- if isNoindex %}
<meta name="robots" content="noindex, follow">
{%- endif %}
{%- if ogTitle or title %}
<meta property="og:title" content="{{ ogTitle or title }}">
{%- endif %}
{%- if ogDescription or description %}
<meta property="og:description" content="{{ ogDescription or description }}">
{%- endif %}
<meta property="og:type" content="{{ ogType or 'website' }}">
{%- if canonical %}
<meta property="og:url" content="{{ canonical }}">
{%- endif %}
<meta name="twitter:card" content="summary">
<meta name="theme-color" content="{{ site.themeColor }}">
<link rel="manifest" href="/manifest.json">
{%- if canonical %}
<link rel="canonical" href="{{ canonical }}">
{%- endif %}
{#- hreflang alternates: derive each language's URL from the canonical by
    stripping any current language prefix and prepending the target's. -#}
{%- if canonical and languages and not noAlternates and not isNoindex %}
{%- set currentLang = lang or languages.default %}
{%- set basePath = canonicalPath %}
{%- if currentLang != languages.default %}
  {%- set stripped = basePath | replace("/" + currentLang + "/", "/") %}
{%- else %}
  {%- set stripped = basePath %}
{%- endif %}
{%- set availableLocales = pageLocales[stripped] or [] %}
{%- for l in languages.available %}
{%- if availableLocales.length == 0 or availableLocales.indexOf(l.code) != -1 %}
<link rel="alternate" hreflang="{{ l.code }}" href="{{ site.url }}{{ l.prefix }}{{ stripped }}">
{%- endif %}
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ stripped }}">
{%- endif %}
<link rel="stylesheet" href="/assets/style.css">
{%- if jsonLd %}
<script type="application/ld+json">
{{ jsonLd | safe }}
</script>
{%- endif %}
{%- if extraHead %}
{{ extraHead | safe }}
{%- endif %}
{%- if pageStyle %}
<style>
{{ pageStyle | safe }}
</style>
{%- endif %}
</head>
<body>

{%- if not hideNav %}
{% include "partials/nav.njk" %}
{%- endif %}

{%- set breadcrumbSchema = breadcrumbs or schemaBreadcrumbs %}
{%- if breadcrumbs %}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {%- for crumb in breadcrumbs %}
    <li>
      {%- if not loop.last %}
      <a href="{{ crumb.url }}">{{ crumb.label }}</a>
      {%- else %}
      <span aria-current="page">{{ crumb.label }}</span>
      {%- endif %}
    </li>
    {%- endfor %}
  </ol>
</nav>
{%- endif %}
{%- if breadcrumbSchema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {%- for crumb in breadcrumbSchema %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "name": "{{ crumb.label }}",
      "item": "{{ site.url }}{{ crumb.url }}"
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{%- endif %}

{{ content | safe }}

{%- if aiCommercialNotice %}
<section class="ai-commercial-note" aria-label="AI tool pricing and disclosure note">
  <div class="container">
    <p><strong>AI tool note:</strong> AI tools, plans, free limits and features can change quickly. Use these pages as practical decision guides, then confirm current details on each provider's official site before subscribing. If sponsored or affiliate links are added later, they should be disclosed clearly and should not change the price you pay. Read <a href="/ai/how-we-review/">how we review AI tools</a> and the <a href="/affiliate-disclosure.html">affiliate disclosure</a>.</p>
  </div>
</section>
{%- endif %}

{% include "partials/footer.njk" %}

<script>
window.bindGlobalShortcut = function (action, options) {
  const opts = options || {};
  const keys = opts.keys || ["Space", "Enter"];
  const allowTextarea = Boolean(opts.allowTextarea);
  document.addEventListener("keydown", function (e) {
    const t = e.target;
    if (t) {
      const isInput = t.tagName === "INPUT";
      const isTextarea = t.tagName === "TEXTAREA";
      const isSelect = t.tagName === "SELECT";
      if (isInput || isSelect || t.isContentEditable || (!allowTextarea && isTextarea)) {
        return;
      }
    }
    if (keys.includes(e.code)) {
      e.preventDefault();
      action(e);
    }
  });
};

window.copySpinnitText = function (text, button, resetLabel) {
  if (!text) return;
  navigator.clipboard.writeText(text).then(function () {
    if (!button) return;
    const original = resetLabel || button.textContent;
    button.textContent = "Copied!";
    button.classList.add("copied");
    setTimeout(function () {
      button.textContent = original;
      button.classList.remove("copied");
    }, 2000);
  });
};

window.spinnitEmbedCode = function (path, title) {
  const src = new URL(path, window.location.origin).toString();
  return `<iframe src="${src}" title="${title}" width="100%" height="640" loading="lazy" style="border:0;border-radius:12px;max-width:720px;"></iframe>`;
};

window.copySpinnitEmbed = function (path, title, button) {
  window.copySpinnitText(window.spinnitEmbedCode(path, title), button, "Copy embed");
};

window.shareOrCopySpinnit = function (payload, button) {
  const data = payload || {};
  if (navigator.share) {
    navigator.share({
      title: data.title || document.title,
      text: data.text || "",
      url: data.url || window.location.href
    }).catch(function () {});
    return;
  }
  const text = [data.text, data.url || window.location.href].filter(Boolean).join("\n");
  window.copySpinnitText(text, button, "Share");
};

window.toggleSpinnitProjectorMode = function (button) {
  const active = document.body.classList.toggle("projector-mode");
  if (button) button.textContent = active ? "Exit projector" : "Projector mode";
  if (active && document.documentElement.requestFullscreen) {
    document.documentElement.requestFullscreen().catch(function () {});
  } else if (!active && document.fullscreenElement && document.exitFullscreen) {
    document.exitFullscreen().catch(function () {});
  }
};
</script>

{%- if pageScript %}
<script>
{{ pageScript | safe }}
</script>
{%- endif %}

</body>
</html>
